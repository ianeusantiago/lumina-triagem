#!/bin/sh
# Bloqueia chaves e .env; roda os testes.
if git diff --cached --name-only | grep -qE '(^|/)\.env($|\.)'; then
  echo "pre-commit: arquivo .env no commit. Abortado." >&2; exit 1
fi
if git diff --cached -U0 | grep -E '^\+' | grep -q 'sk-an[t]-'; then
  echo "pre-commit: possível chave da API no commit. Abortado." >&2; exit 1
fi
python -m pytest -q || { echo "pre-commit: testes falharam." >&2; exit 1; }
